include $(src)/backend/gpu/Kbuild

obj-$(CONFIG_MALI_MIDGARD) += mali.o
mali-y := $(SRC:.c=.o) $(BACKEND:.c=.o) platform/sharkle/mali_kbase_config_sharkle.o

mali-y += mali_kbase_sync_file.o mali_kbase_sync_common.o mali_kbase_fence.o
ifeq ($(CONFIG_DEVFREQ_THERMAL),y)
