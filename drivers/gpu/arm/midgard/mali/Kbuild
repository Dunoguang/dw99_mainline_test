# Arm Midgard kbase as shipped for the SharkLE platform.
ifneq ($(KBUILD_EXTMOD),)
CONFIG_MALI_MIDGARD ?= m
endif

MALI_CUSTOMER_RELEASE := 1
CONFIG_MALI_DEVFREQ := y

ccflags-y += -DMALI_CUSTOMER_RELEASE=1 -DMALI_USE_CSF=0
ccflags-y += -DMALI_KERNEL_TEST_API=0 -DMALI_UNIT_TEST=0
ccflags-y += -DMALI_COVERAGE=0 -DMALI_INSTRUMENTATION_LEVEL=0
ccflags-y += -DMALI_RELEASE_NAME=\"r28p0-01rel0\"
ccflags-y += -DMALI_KBASE_BUILD -DCONFIG_MALI_DEVFREQ
ccflags-y += -DCONFIG_INIT_VOLTAGE -DCONFIG_ADJUST_VOLTAGE -DCONFIG_MALI_BOOST
ccflags-y += -I$(src) -I$(src)/backend/gpu -I$(src)/platform/sharkle
ccflags-y += -I$(srctree)/drivers/staging/android

SRC := \
	mali_kbase_device.c \
	mali_kbase_cache_policy.c \
	mali_kbase_mem.c \
	mali_kbase_mmu.c \
	mali_kbase_ctx_sched.c \
